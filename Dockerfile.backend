# Multi-stage Dockerfile for FastAPI Backend with OAuth Integration
# Stage 1: Build stage with all build dependencies
FROM python:3.10-slim-bullseye AS builder

# Set the working directory in the container
WORKDIR /app

# Install system dependencies needed for building Python packages
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    curl \
    pkg-config \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy the requirements file first to leverage Docker cache
COPY requirements.txt .

# Create a virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip and install Python dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install Cython first (required for IndicTransToolkit)
RUN pip install --no-cache-dir cython

# Install core dependencies first to catch any issues early
RUN pip install --no-cache-dir fastapi==0.111.0 uvicorn==0.30.1 gunicorn==22.0.0

# Install algoliasearch explicitly with version
RUN pip install --no-cache-dir algoliasearch==3.0.0

# Install remaining packages from requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy IndicTransToolkit and install it
COPY IndicTransToolkit-main/ ./IndicTransToolkit-main/
WORKDIR /app/IndicTransToolkit-main

# Install IndicTransToolkit from source
RUN pip install --no-cache-dir .

# Return to app directory
WORKDIR /app

# Verify critical imports work
RUN python -c "from algoliasearch.search_client import SearchClient; print('Algoliasearch import successful')"
RUN python -c "from IndicTransToolkit.processor import IndicProcessor; print('IndicTransToolkit import successful')"

# Stage 2: Runtime stage with minimal dependencies
FROM python:3.10-slim-bullseye AS runtime

# Set the working directory in the container
WORKDIR /app

# Install only runtime system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy the virtual environment from builder stage
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Create non-root user for security (MOVED UP)
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Set Hugging Face and Matplotlib cache directories and create them with appuser permissions
ENV HF_HOME=/app/.cache/huggingface
# Explicitly set TRANSFORMERS_CACHE for Hugging Face
ENV TRANSFORMERS_CACHE=/app/.cache/huggingface
# Set Matplotlib cache directory
ENV MPLCONFIGDIR=/app/.cache/matplotlib

RUN mkdir -p ${HF_HOME} \
    && mkdir -p ${MPLCONFIGDIR} \
    && chown -R appuser:appuser /app/.cache

# Copy the main application files
COPY --chown=appuser:appuser app.py .
COPY --chown=appuser:appuser fraud_detection.py .

# Copy OAuth integration files (FIXED: Added all OAuth files)
COPY --chown=appuser:appuser oauth_routes.py .
COPY --chown=appuser:appuser oauth_config.py .
COPY --chown=appuser:appuser google_oauth.py .
COPY --chown=appuser:appuser facebook_oauth.py .
COPY --chown=appuser:appuser jwt_utils.py .

# Copy data files
COPY --chown=appuser:appuser DEhli.csv .
COPY --chown=appuser:appuser ngo_fraud.csv .

# Copy Firebase service account key (if needed)
COPY --chown=appuser:appuser firebase-service-account-key.json .

# Copy static directory if it exists
COPY --chown=appuser:appuser static/ ./static/

# Create necessary directories with proper permissions
RUN mkdir -p /app/static/icons /app/static/shap_plots \
    && chown -R appuser:appuser /app/static

# Switch to non-root user
USER appuser

# Expose the port that Gunicorn will run on internally
EXPOSE 8000

# Explicitly set the PORT environment variable for deployment platforms
ENV PORT=8000

# Add a HEALTHCHECK to help cloud platforms monitor the container
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=40s \
  CMD curl --fail http://localhost:8000/health || exit 1

# Command to run the FastAPI application using Gunicorn with Uvicorn workers
# Changed CMD to use 'python -m gunicorn' for more explicit module loading
CMD ["python", "-m", "gunicorn", "app:app", "--workers", "2", "--worker-class", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000", "--timeout", "120", "--keep-alive", "2", "--max-requests", "1000", "--max-requests-jitter", "100"]
