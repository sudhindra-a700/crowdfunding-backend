# HAVEN Crowdfunding Platform - Backend Dockerfile for Render
# Using Python 3.11 and direct CMD instruction

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Set environment variables to optimize Python and Pip
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies required for libraries like psycopg2
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    libpq-dev \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip to the latest version
RUN pip install --upgrade pip

# Copy requirements first to leverage Docker layer caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install -r requirements.txt

# Download NLTK data required for the application during the build
RUN python -c "import nltk; nltk.download('punkt'); nltk.download('wordnet'); nltk.download('stopwords'); nltk.download('averaged_perceptron_tagger')"

# Copy the rest of the application code into the container
COPY . .

# Create necessary directories for static files, uploads, and logs
RUN mkdir -p /app/static /app/uploads /app/logs

# Set permissions on the app directory
RUN chmod +x /app

# Expose the port. Render will detect the service on the port specified by the PORT env var.
EXPOSE 8000

# Health check to ensure the application is running correctly
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT:-10000}/health || exit 1

# --- START COMMAND ---
# This CMD runs directly in a shell, which correctly substitutes the $PORT variable.
# This removes the need for an external start.sh script.
CMD uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1 --timeout-keep-alive 30
